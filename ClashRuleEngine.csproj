<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <!--
    ================================================================
    NAVISWORKS VERSION TARGETING
    One build per Navisworks version. Pick the version with:
        msbuild /p:NavisworksVersion=2026
    Default: newest installed version (2028 → 2024 probe order).
    API reference DLLs resolve from, in order:
      1. Refs\<version>\   (checked-in copies for versions not installed here)
      2. C:\Program Files\Autodesk\Navisworks Manage <version>\
    ================================================================
  -->
  <PropertyGroup>
    <NavisworksVersion Condition="'$(NavisworksVersion)' == '' AND Exists('C:\Program Files\Autodesk\Navisworks Manage 2028')">2028</NavisworksVersion>
    <NavisworksVersion Condition="'$(NavisworksVersion)' == '' AND Exists('C:\Program Files\Autodesk\Navisworks Manage 2027')">2027</NavisworksVersion>
    <NavisworksVersion Condition="'$(NavisworksVersion)' == '' AND Exists('C:\Program Files\Autodesk\Navisworks Manage 2026')">2026</NavisworksVersion>
    <NavisworksVersion Condition="'$(NavisworksVersion)' == '' AND Exists('C:\Program Files\Autodesk\Navisworks Manage 2025')">2025</NavisworksVersion>
    <NavisworksVersion Condition="'$(NavisworksVersion)' == '' AND Exists('C:\Program Files\Autodesk\Navisworks Manage 2024')">2024</NavisworksVersion>
    <NavisworksVersion Condition="'$(NavisworksVersion)' == ''">2027</NavisworksVersion>

    <NavisworksPath Condition="'$(NavisworksPath)' == '' AND Exists('$(MSBuildProjectDirectory)\Refs\$(NavisworksVersion)\Autodesk.Navisworks.Api.dll')">$(MSBuildProjectDirectory)\Refs\$(NavisworksVersion)</NavisworksPath>
    <NavisworksPath Condition="'$(NavisworksPath)' == ''">C:\Program Files\Autodesk\Navisworks Manage $(NavisworksVersion)</NavisworksPath>
  </PropertyGroup>

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{A1B2C3D4-1234-5678-9ABC-DEF012345678}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>ClashRuleEngine</RootNamespace>
    <AssemblyName>ClashRuleEngine</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- e.g. NW2027 — for version-specific conditional compilation -->
    <NavisDefine>NW$(NavisworksVersion)</NavisDefine>
    <!-- Clash tests live in a ClashTestFolder TREE (see Services\ClashApiCompat.cs).
         Threshold is 2026, NOT 2027: verified by reflection 2026-08-10 that Navisworks 2026
         already has ClashTestsData.TestsRoot AND the ClashTestFolder type, so it supports
         clash-test folders too. It also still has the legacy flat DocumentClashTests.Tests,
         which 2027 dropped — but enumerating that on 2026 would silently MISS any test filed
         inside a folder, so both versions use the folder-aware path. -->
    <NavisDefine Condition="'$(NavisworksVersion)' &gt;= '2026'">$(NavisDefine);NW_TESTS_TREE</NavisDefine>
  </PropertyGroup>

  <!-- Debug config -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\x64\Debug\$(NavisworksVersion)\</OutputPath>
    <DefineConstants>DEBUG;TRACE;$(NavisDefine)</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- Release config -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\x64\Release\$(NavisworksVersion)\</OutputPath>
    <DefineConstants>TRACE;$(NavisDefine)</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- Standard .NET Framework references -->
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- Navisworks API References — Private=False so they are NOT copied to output.

       REQUIRED: Api + Clash. Those are the ONLY two the plugin actually uses (verified
       2026-08-10 by reading GetReferencedAssemblies() on the built DLL — the compiler
       emits a reference only for an assembly a type is really used from).

       OPTIONAL: Automation + Controls are conditional on the file existing. They were
       declared but unused: the Automation API is driven from tools\BatchExtractor and
       tools\NwdClashLearner, which are SEPARATE projects with their own references.
       Making them conditional means harvesting a version's refs needs 2 DLLs, not 4 —
       which matters because Automation.dll is the one file the community NuGet
       reference packages do not carry. Re-add a hard reference if plugin code ever
       genuinely needs one of these. -->
  <ItemGroup>
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksPath)\Autodesk.Navisworks.Api.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Clash">
      <HintPath>$(NavisworksPath)\Autodesk.Navisworks.Clash.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Automation"
              Condition="Exists('$(NavisworksPath)\Autodesk.Navisworks.Automation.dll')">
      <HintPath>$(NavisworksPath)\Autodesk.Navisworks.Automation.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Controls"
              Condition="Exists('$(NavisworksPath)\Autodesk.Navisworks.Controls.dll')">
      <HintPath>$(NavisworksPath)\Autodesk.Navisworks.Controls.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckNavisworksRefs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(NavisworksPath)\Autodesk.Navisworks.Api.dll')"
           Text="Navisworks $(NavisworksVersion) API references not found at '$(NavisworksPath)'. Install that version, or harvest its DLLs: tools\harvest-refs.ps1 -Version $(NavisworksVersion)" />
  </Target>

  <!-- C# source files -->
  <ItemGroup>
    <Compile Include="Models\ClashRule.cs" />
    <Compile Include="Models\RuleCondition.cs" />
    <Compile Include="Models\KindRule.cs" />
    <Compile Include="Models\ApprovePolicy.cs" />
    <Compile Include="Models\TestRuleSet.cs" />
    <Compile Include="Plugin\PluginIds.cs" />
    <Compile Include="Plugin\ClashRuleEnginePlugin.cs" />
    <Compile Include="Plugin\ClashMarkerPlugins.cs" />
    <Compile Include="Plugin\BatchClashExtractPlugin.cs" />
    <Compile Include="Services\AiRuleGenerator.cs" />
    <Compile Include="Services\BuiltInRuleSets.cs" />
    <Compile Include="Services\ClashApiCompat.cs" />
    <Compile Include="Services\ElementKind.cs" />
    <Compile Include="Services\KindRuleImport.cs" />
    <Compile Include="Services\ClashMarkerService.cs" />
    <Compile Include="Services\ClashNavigationService.cs" />
    <Compile Include="Services\ClashProcessingService.cs" />
    <Compile Include="Services\ClaudeApiService.cs" />
    <Compile Include="Services\ClashTestScanner.cs" />
    <Compile Include="Services\RulePersistenceService.cs" />
    <Compile Include="Services\ModelPropertyScanner.cs" />
    <Compile Include="Services\SessionExportService.cs" />
    <Compile Include="UI\Converters.cs" />
    <Compile Include="UI\ClashMatrixDialog.cs" />
    <Compile Include="UI\ExportProgressWindow.cs" />
    <Compile Include="UI\AiAssistDialog.xaml.cs">
      <DependentUpon>AiAssistDialog.xaml</DependentUpon>
    </Compile>
    <Compile Include="UI\ClashInspectorDialog.xaml.cs">
      <DependentUpon>ClashInspectorDialog.xaml</DependentUpon>
    </Compile>
    <Compile Include="UI\RuleEditorDialog.xaml.cs">
      <DependentUpon>RuleEditorDialog.xaml</DependentUpon>
    </Compile>
    <Compile Include="UI\RuleEnginePanel.xaml.cs">
      <DependentUpon>RuleEnginePanel.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- XAML pages -->
  <ItemGroup>
    <Page Include="UI\AiAssistDialog.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="UI\ClashInspectorDialog.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="UI\RuleEditorDialog.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="UI\RuleEnginePanel.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <!-- Other files -->
  <ItemGroup>
    <None Include="PackageContents.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ============================================================
       RIBBON LAYOUT + STRINGS — LOOSE FILES IN A LANGUAGE FOLDER
       ============================================================
       Navisworks resolves the [RibbonLayout] .xaml and [Strings] .name for a
       CommandHandlerPlugin from a LOCALE SUBFOLDER NEXT TO THE PLUGIN DLL:

           Plugins\ClashRuleEngine\
               ClashRuleEngine.dll
               en-US\ClashRuleEngineRibbon.xaml
               en-US\ClashRuleEngine.name
               Images\*.ico

       Ground truth: the post-build event of the SDK sample
       api\net\examples\Basic Examples\CSharp\CustomRibbon\CustomRibbon.csproj —
           xcopy /Y "$(TargetPath)"    "...\Plugins\$(TargetName)\"
           mkdir                       "...\Plugins\$(TargetName)\en-US"
           copy /Y "CustomRibbon.xaml" "...\Plugins\$(TargetName)\en-US\"
           copy /Y "CustomRibbon.name" "...\Plugins\$(TargetName)\en-US\"
           xcopy /Y "Images\*.*"       "...\Plugins\$(TargetName)\Images\"
       — where both files are plain <None> + CopyToOutputDirectory. Navisworks'
       own ribbons ship the same way (<install>\en-US\Ribbon.xaml,
       <install>\en-US\Clash.Plugin.name).

       THIS WAS AN EMBEDDEDRESOURCE WITH A LogicalName UNTIL 2026-08-10, on the
       belief that Navisworks looked the layout up as "<RootNamespace>.<file>".
       It does not, and that is why the custom ribbon tab NEVER appeared — the
       resource name was correct and irrelevant. Do not "restore" that.

       A non-English Navisworks would need the same two files under its own locale
       folder (de-DE, ja-JP, …); only en-US is shipped.
       ============================================================ -->
  <ItemGroup>
    <RibbonLayoutFile Include="Plugin\ClashRuleEngineRibbon.xaml" />
    <RibbonLayoutFile Include="Plugin\ClashRuleEngine.name" />
    <None Include="@(RibbonLayoutFile)" />
  </ItemGroup>

  <Target Name="StagePluginPayload" AfterTargets="Build">
    <Error Condition="!Exists('%(RibbonLayoutFile.FullPath)')"
           Text="Ribbon layout file missing: %(RibbonLayoutFile.Identity) — the custom ribbon tab will not appear without it." />
    <Copy SourceFiles="@(RibbonLayoutFile)" DestinationFolder="$(OutDir)en-US" SkipUnchangedFiles="true" />
    <!-- Icons go BOTH flat and in Images\: the SDK docs say Icon/LargeIcon resolve
         next to the DLL *or* in an Images\ subfolder, and the sample uses Images\.
         Shipping both costs ~5 KB and removes a guess. -->
    <Copy SourceFiles="@(RibbonIcon)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RibbonIcon)" DestinationFolder="$(OutDir)Images" SkipUnchangedFiles="true" />
  </Target>

  <!-- ============================================================
       SHIPPED RULE SETS — embedded so there is no file to send anyone
       ============================================================
       These ARE embedded resources (unlike the ribbon layout, which Navisworks itself
       must find on disk — see the note further down). Nothing outside our own code
       reads them: Services\BuiltInRuleSets looks them up by these exact LogicalNames,
       and a mismatch throws at runtime listing the names that ARE present.

       LogicalName is set explicitly because the default would embed the folder path
       ("ClashRuleEngine.Resources.RuleSets.current.clashre"), which is noise.

       current.clashre ~1 MB is deliberate: it is the real production config, a hybrid
       that neither analyzer JSON reproduces alone (923 pair rules from the full set +
       25 per-test defaults from the mined set). The installer's lzma2 squeezes it right
       back down, so the setup.exe barely grows. Regenerate with tools\stage-rulesets.ps1.
       ============================================================ -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\RuleSets\current.clashre">
      <LogicalName>ClashRuleEngine.RuleSets.current.clashre</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\RuleSets\mined.json">
      <LogicalName>ClashRuleEngine.RuleSets.mined.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Ribbon icons, staged by StagePluginPayload below (flat + Images\).
       Regenerate them from the brand logo with tools\make-icons.ps1. -->
  <ItemGroup>
    <RibbonIcon Include="Resources\oconnors_clash_16.ico" />
    <RibbonIcon Include="Resources\oconnors_clash_32.ico" />
    <RibbonIcon Include="Resources\oconnors_extract_16.ico" />
    <RibbonIcon Include="Resources\oconnors_extract_32.ico" />
    <None Include="Resources\oconnors_logo.png" />
  </ItemGroup>

  <Target Name="CheckRibbonIcons" BeforeTargets="StagePluginPayload">
    <Error Condition="!Exists('%(RibbonIcon.FullPath)')"
           Text="Ribbon icon missing: %(RibbonIcon.Identity). Run tools\make-icons.ps1." />
  </Target>

  <!-- NOTE: there is deliberately NO post-build copy into the Navisworks plugin folder.
       The only location Navisworks 2027 honours is the INSTALL's Plugins folder, which
       needs elevation - see tools\deploy.ps1 (dev) and Installer\ (team rollout). The
       old target copied to %AppData%\Autodesk Navisworks Manage <ver>\Plugins, which
       2027 ignores entirely, so it silently deployed nothing. -->


  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

</Project>
